<% content_for :title, "帳票: 代理・在庫" %>
<% amount = ->(value) { value.present? ? number_with_delimiter(value) : "" } %>
<% yen = ->(value) { number_to_currency(value.to_i, unit: "¥", precision: 0) } %>

<form id="proxy-inventory-report-form" action="<%= save_proxy_inventory_reports_path %>" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

  <section class="page-head">
    <div>
      <h2>帳票: 代理・在庫</h2>
      <p class="section-lead">聖明王院 <%= current_event&.name %>八大明王護摩供 売上表</p>
    </div>
    <div class="page-head-actions no-print" style="display: flex; gap: 0.5rem;">
      <button class="primary-button" type="submit" style="padding: 0.4rem 1rem;">保存</button>
      <button class="secondary-button" type="submit" formmethod="get" formaction="<%= proxy_inventory_reports_path(format: :csv) %>" style="padding: 0.4rem 1rem;">CSV</button>
      <button class="secondary-button" type="submit" formmethod="get" formaction="<%= proxy_inventory_reports_path(format: :pdf) %>" style="padding: 0.4rem 1rem;">PDF保存</button>
    </div>
  </section>

<section class="card proxy-inventory-sheet" data-proxy-inventory-report data-pre-event-sales="<%= @pre_event_totals[:sales] %>" data-pre-event-seiin="<%= @pre_event_totals[:seiin_amount] %>" data-pre-event-miroku="<%= @pre_event_totals[:miroku_amount] %>">
  <header class="report-document-head">
    <div>
      <h3>表② 代理奉納</h3>
      <p>地方代理＝護摩センター振込分。代理奉納分は表②に記入します。</p>
    </div>
  </header>

  <div class="table-wrap">
    <table class="report-table proxy-report-table">
      <thead>
        <tr>
          <th>道具名</th>
          <th class="text-right">奉納料</th>
          <th class="text-right">奉納数</th>
          <th class="text-right">売上</th>
          <th class="text-right">還付金</th>
          <th class="text-right">聖院還付分</th>
          <th class="text-right">弥勒寺</th>
          <th class="text-right">弥勒寺入金分</th>
        </tr>
      </thead>
      <tbody>
        <% @rows.each_with_index do |row, index| %>
          <tr data-row="<%= index %>"
              data-unit-price="<%= row[:unit_price] %>"
              data-quantity="<%= row[:quantity] %>"
              data-refund-unit="<%= row[:refund_unit] %>"
              data-miroku-unit="<%= row[:miroku_unit] %>">
            <td><%= row[:label] %></td>
            <td class="text-right"><%= amount.call(row[:unit_price]) %></td>
            <% if row[:form_type].present? %>
              <td class="text-right" data-auto-quantity-display><%= amount.call(row[:quantity]) %></td>
            <% else %>
              <td>
                <input type="number" min="0" value="<%= row[:quantity] %>" name="quantities[<%= index %>]" class="report-input proxy-quantity-input" data-quantity-input>
              </td>
            <% end %>
            <td class="text-right" data-sales-display><%= amount.call(row[:sales]) %></td>
            <td class="text-right"><%= amount.call(row[:refund_unit]) %></td>
            <td class="text-right" data-seiin-amount-display><%= amount.call(row[:seiin_amount]) %></td>
            <td class="text-right"><%= amount.call(row[:miroku_unit]) %></td>
            <td class="text-right" data-miroku-amount-display><%= amount.call(row[:miroku_amount]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="table-wrap proxy-summary-wrap">
    <table class="proxy-summary-table">
      <colgroup>
        <col class="proxy-summary-label-column">
        <col class="proxy-summary-amount-column">
        <col class="proxy-summary-note-column">
        <col class="proxy-summary-amount-column">
        <col class="proxy-summary-note-column">
        <col class="proxy-summary-amount-column">
      </colgroup>
      <tbody>
        <tr>
          <th>② 代理奉納合計</th>
          <td class="text-right" data-proxy-total-sales><%= yen.call(@proxy_totals[:sales]) %></td>
          <th class="proxy-summary-note">※聖院分<br>として<br>入金</th>
          <td class="text-right" data-proxy-total-seiin><%= yen.call(@proxy_totals[:seiin_amount]) %></td>
          <th class="proxy-summary-note">弥勒寺分</th>
          <td class="text-right" data-proxy-total-miroku><%= yen.call(@proxy_totals[:miroku_amount]) %></td>
        </tr>
        <tr>
          <th>①前日・当日売上合計</th>
          <td class="text-right"><%= yen.call(@pre_event_totals[:sales]) %></td>
          <th class="proxy-summary-note">聖院分</th>
          <td class="text-right"><%= yen.call(@pre_event_totals[:seiin_amount]) %></td>
          <th class="proxy-summary-note">弥勒寺分</th>
          <td class="text-right"><%= yen.call(@pre_event_totals[:miroku_amount]) %></td>
        </tr>
        <tr>
          <th>地護摩供売上総合計（①＋②）</th>
          <td class="text-right" data-grand-total-sales><%= yen.call(@grand_totals[:sales]) %></td>
          <th class="proxy-summary-note">聖院還付<br>合計</th>
          <td class="text-right" data-grand-total-seiin><%= yen.call(@grand_totals[:seiin_amount]) %></td>
          <th class="proxy-summary-note">弥勒寺分<br>合計</th>
          <td class="text-right" data-grand-total-miroku><%= yen.call(@grand_totals[:miroku_amount]) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="report-note">※令和元年より、代理奉納の聖院還付は、みろく寺の道具請求(平成27年度までの未入金分）の方へ当てさせていただくことになりました。（4月18日の通達参照）</p>

  <h4 class="inventory-heading">道具数チェック</h4>
  <div class="table-wrap">
    <table class="report-table inventory-check-table">
      <thead>
        <tr>
          <th>道具名</th>
          <th class="text-right">在庫数</th>
          <th class="text-right">注文数(合計)</th>
          <th class="text-right">代理奉納数(合計)</th>
          <th class="text-right">前日・当日売上数</th>
          <th class="text-right">残数</th>
        </tr>
      </thead>
      <tbody>
        <% @inventory_rows.each do |row| %>
          <tr>
            <td><%= row[:label] %></td>
            <td class="text-right"><%= amount.call(row[:stock_count]) %></td>
            <td class="text-right"><%= amount.call(row[:order_total]) %></td>
            <td class="text-right"><%= amount.call(row[:proxy_quantity]) %></td>
            <td class="text-right"><%= amount.call(row[:pre_event_quantity]) %></td>
            <td class="text-right"><%= amount.call(row[:remaining_count]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <p class="report-contact">報告担当者：尾ノ上裕美　連絡先：09041779036</p>
</section>
</form>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.querySelector("[data-proxy-inventory-report]");
  if (!container) return;

  const rows = container.querySelectorAll(".proxy-report-table tbody tr");
  const preEventSales = parseInt(container.dataset.preEventSales) || 0;
  const preEventSeiin = parseInt(container.dataset.preEventSeiin) || 0;
  const preEventMiroku = parseInt(container.dataset.preEventMiroku) || 0;

  const formatNumber = (amount) => amount ? amount.toLocaleString() : "";
  const formatCurrency = (amount) => "¥" + amount.toLocaleString();

  const setText = (selector, value) => {
    const element = container.querySelector(selector);
    if (element) element.textContent = value;
  };

  const updateCalculations = () => {
    let proxySales = 0;
    let proxySeiin = 0;
    let proxyMiroku = 0;

    rows.forEach(row => {
      const input = row.querySelector("[data-quantity-input]");
      const rawQuantity = input ? input.value.trim() : row.dataset.quantity;
      const quantity = rawQuantity === "" ? null : Math.max(parseInt(rawQuantity) || 0, 0);
      const unitPrice = parseInt(row.dataset.unitPrice) || 0;
      const refundUnitRaw = row.dataset.refundUnit;
      const mirokuUnitRaw = row.dataset.mirokuUnit;
      const hasRefundUnit = refundUnitRaw !== "";
      const hasMirokuUnit = mirokuUnitRaw !== "";

      const sales = quantity === null ? null : quantity * unitPrice;
      const seiinAmount = quantity === null || !hasRefundUnit ? null : quantity * (parseInt(refundUnitRaw) || 0);
      const mirokuAmount = quantity === null || !hasMirokuUnit ? null : quantity * (parseInt(mirokuUnitRaw) || 0);

      row.querySelector("[data-sales-display]").textContent = formatNumber(sales);
      row.querySelector("[data-seiin-amount-display]").textContent = formatNumber(seiinAmount);
      row.querySelector("[data-miroku-amount-display]").textContent = formatNumber(mirokuAmount);

      proxySales += sales || 0;
      proxySeiin += seiinAmount || 0;
      proxyMiroku += mirokuAmount || 0;
    });

    setText("[data-proxy-total-sales]", formatCurrency(proxySales));
    setText("[data-proxy-total-seiin]", formatCurrency(proxySeiin));
    setText("[data-proxy-total-miroku]", formatCurrency(proxyMiroku));
    setText("[data-grand-total-sales]", formatCurrency(proxySales + preEventSales));
    setText("[data-grand-total-seiin]", formatCurrency(proxySeiin + preEventSeiin));
    setText("[data-grand-total-miroku]", formatCurrency(proxyMiroku + preEventMiroku));
  };

  container.querySelectorAll("[data-quantity-input]").forEach(input => {
    input.addEventListener("input", updateCalculations);
    input.addEventListener("focus", () => input.select());
    input.addEventListener("click", () => input.select());
  });

  updateCalculations();
});
</script>

<style>
.report-input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 0.4rem 0.6rem;
  font-size: 1rem;
  text-align: right;
  appearance: textfield;
  -moz-appearance: textfield;
}

.report-input::-webkit-outer-spin-button,
.report-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.proxy-quantity-input {
  min-width: 5.5rem;
}

.report-document-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.report-document-head h3,
.report-document-head h4,
.inventory-heading {
  color: var(--ink);
  margin: 0 0 0.5rem;
}

.report-document-head p,
.report-note,
.report-contact {
  color: var(--muted);
  margin: 0 0 1rem;
}

.total-row {
  font-weight: 800;
  background: var(--accent-soft);
}

.total-row td {
  border-top: 2px solid var(--accent);
}

.proxy-summary-wrap {
  margin-top: 1rem;
}

.proxy-summary-table {
  width: 100%;
  border-collapse: collapse;
  color: var(--ink);
  table-layout: fixed;
}

.proxy-summary-table th,
.proxy-summary-table td {
  border: 3px solid var(--ink);
  font-weight: 800;
  padding: 0.75rem 0.65rem;
  vertical-align: middle;
}

.proxy-summary-table th {
  background: var(--accent-soft);
  text-align: left;
}

.proxy-summary-table td {
  background: #fff;
  font-size: 1.35rem;
  white-space: nowrap;
}

.proxy-summary-note {
  text-align: center;
  line-height: 1.15;
}

.proxy-summary-label-column {
  width: 28%;
}

.proxy-summary-amount-column {
  width: 16%;
}

.proxy-summary-note-column {
  width: 8%;
}

.inventory-heading {
  margin-top: 1.5rem;
}

.inventory-check-table th,
.inventory-check-table td {
  white-space: nowrap;
}

.report-contact {
  margin-top: 1rem;
  text-align: right;
}
</style>
